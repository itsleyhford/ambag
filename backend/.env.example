# backend/.env.example
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env (it is in .gitignore).

# Server
PORT=5000
NODE_ENV=development
# The only website allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173
# Long random text used to sign login tokens. In production use 32+ characters.
JWT_SECRET=change-me-to-a-long-random-string
# Time zone used for "today" in date rules (excuse dates)
APP_TIMEZONE=Asia/Manila

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ambag
# false for local MySQL; true for cloud databases (TiDB Cloud, Aiven)
DB_SSL=false
# Optional: CA certificate for the cloud database, on one line with \n for new lines
DB_CA=

{
  "name": "ambag-backend",
  "version": "1.0.0",
  "description": "AMBAG API: Express + MySQL backend for the group-project contribution tracker",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
